arch=('x86_64')
url='https://github.com/Kreijstal/wine-kreijstal'
license=('LGPL-2.1-or-later')
provides=('wine' 'wine-wow64')
conflicts=('wine' 'wine-staging' 'wine-git' 'wine-kreijstal-bin')
options=('!strip' '!lto')

