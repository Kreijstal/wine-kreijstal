source=('git+https://github.com/Kreijstal/wine-kreijstal.git#branch=kreijstal-fixes')
sha256sums=('SKIP')

pkgver() {
  cd wine-kreijstal
  local version
  version="$(sed -n 's/^m4_define(\[wine_version\],\[\(.*\)\])/\1/p' configure.ac)"
  printf '%s.r%s.g%s' "${version:-11.10}" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd wine-kreijstal
  ./build-wine-simple.sh
}

package() {
  cd wine-kreijstal
  make -C build64 install DESTDIR="${pkgdir}"
  make -C build32 install DESTDIR="${pkgdir}"
}
