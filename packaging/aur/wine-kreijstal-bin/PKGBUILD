# Maintainer: Kreijstal <aur@users.noreply.github.com>

pkgname=wine-kreijstal-bin
pkgver=11.10.20260531
pkgrel=1
pkgdesc='Wine fork with Kreijstal patches, precompiled Arch Linux WoW64 build'
arch=('x86_64')
url='https://github.com/Kreijstal/wine-kreijstal'
license=('LGPL-2.1-or-later')
provides=('wine' 'wine-wow64')
conflicts=('wine' 'wine-staging' 'wine-git')
options=('!strip')

depends=(
  'alsa-lib'
  'ffmpeg'
  'gcc-libs'
  'glib2'
  'glibc>=2.38'
  'gst-plugins-base-libs'
  'gstreamer'
  'libgudev'
  'libpcap'
  'libpulse'
  'libusb'
  'libx11'
  'libxext'
  'libxkbcommon'
  'libxkbcommon-x11'
  'ocl-icd'
  'pcsclite'
  'vulkan-icd-loader'
  'wayland'
)

optdepends=(
  'lib32-alsa-lib: 32-bit ALSA support'
  'lib32-ffmpeg: 32-bit media support'
  'lib32-gcc-libs: 32-bit runtime support'
  'lib32-glib2: 32-bit GLib support'
  'lib32-gst-plugins-base-libs: 32-bit GStreamer plugin base support'
  'lib32-gstreamer: 32-bit GStreamer support'
  'lib32-libgudev: 32-bit udev support'
  'lib32-libpcap: 32-bit packet capture support'
  'lib32-libpulse: 32-bit PulseAudio support'
  'lib32-libusb: 32-bit USB support'
  'lib32-libx11: 32-bit X11 support'
  'lib32-libxext: 32-bit X11 extension support'
  'lib32-libxkbcommon: 32-bit keyboard support'
  'lib32-ocl-icd: 32-bit OpenCL ICD loader'
  'lib32-vulkan-icd-loader: 32-bit Vulkan loader'
  'lib32-wayland: 32-bit Wayland support'
)

_release_tag='kreijstal-local-11.10-20260531-1419'
_archive='wine-kreijstal-11.10-wow64-archlinux-glibc2.38plus-20260531-2056e428099.tar.xz'
source=("${url}/releases/download/${_release_tag}/${_archive}")
sha256sums=('0d6b2f4d7476111d06978c91f5c206ee0495b8a47dcfd9f23a6d68ddbd4478a7')

package() {
  cp -a "${srcdir}"/* "${pkgdir}"/
}
